{
  "schemaVersion": "1",
  "name": "build-fresh-platformer",
  "description": "End-to-end scenario that builds a playable 2D demo scene from scratch using generic Loombridge MCP primitives only. Re-runnable via if_exists:skip on script creation. Saves to Assets/FreshPlatformer.unity.",
  "steps": [
    { "id": "preflight-editor-state", "name": "Preflight: read editor state", "kind": "tool_call", "tool": "unity_editor_get_state", "arguments": {} },
    { "id": "preflight-capabilities", "name": "Preflight: input capabilities", "kind": "tool_call", "tool": "unity_input_get_capabilities", "arguments": {} },

    { "id": "ensure-stopped", "name": "Ensure not in play mode", "kind": "tool_call", "tool": "unity_editor_wait_for", "arguments": { "playMode": "stopped", "timeoutMs": 5000 } },
    { "id": "new-scene", "name": "Create fresh scene", "kind": "tool_call", "tool": "unity_scene_new_scene", "arguments": {} },

    { "id": "cam-ortho", "name": "Camera orthographic on", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Main Camera" }, "type_name": "Camera", "property_path": "orthographic", "value": true } },
    { "id": "cam-size", "name": "Camera orthographic size 2.1", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Main Camera" }, "type_name": "Camera", "property_path": "orthographicSize", "value": 2.1 } },
    { "id": "cam-pos", "name": "Camera position (0,0,-10)", "kind": "tool_call", "tool": "unity_scene_set_transform", "arguments": { "locator": { "path": "/Main Camera" }, "position": { "x": 0, "y": 0, "z": -10 } } },

    { "id": "create-sprite-green", "name": "Create green sprite", "kind": "tool_call", "tool": "unity_asset_create_sprite", "arguments": { "path": "Assets/Sprites/Green.png", "color": { "r": 0.2, "g": 0.8, "b": 0.2, "a": 1 }, "width": 64, "height": 64 } },
    { "id": "create-sprite-blue", "name": "Create blue sprite", "kind": "tool_call", "tool": "unity_asset_create_sprite", "arguments": { "path": "Assets/Sprites/Blue.png", "color": { "r": 0.2, "g": 0.4, "b": 1, "a": 1 }, "width": 64, "height": 64 } },
    { "id": "create-sprite-yellow", "name": "Create yellow sprite", "kind": "tool_call", "tool": "unity_asset_create_sprite", "arguments": { "path": "Assets/Sprites/Yellow.png", "color": { "r": 1, "g": 0.9, "b": 0.2, "a": 1 }, "width": 32, "height": 32 } },

    { "id": "create-ground", "name": "Create ground", "kind": "tool_call", "tool": "unity_scene_create_object", "arguments": { "name": "Ground", "position": { "x": 0, "y": -3, "z": 0 }, "scale": { "x": 18, "y": 0.5, "z": 1 } } },
    { "id": "ground-renderer", "name": "Ground SpriteRenderer", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Ground" }, "type_name": "SpriteRenderer" } },
    { "id": "ground-collider", "name": "Ground BoxCollider2D", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Ground" }, "type_name": "BoxCollider2D" } },
    { "id": "ground-assign", "name": "Assign green sprite to Ground", "kind": "tool_call", "tool": "unity_asset_assign_sprite", "arguments": { "locator": { "path": "/Ground" }, "sprite_path": "Assets/Sprites/Green.png" } },

    { "id": "create-player", "name": "Create Player", "kind": "tool_call", "tool": "unity_scene_create_object", "arguments": { "name": "Player", "position": { "x": 0, "y": -1, "z": 0 }, "scale": { "x": 0.8, "y": 0.8, "z": 1 } } },
    { "id": "player-renderer", "name": "Player SpriteRenderer", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Player" }, "type_name": "SpriteRenderer" } },
    { "id": "player-rb", "name": "Player Rigidbody2D", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Player" }, "type_name": "Rigidbody2D" } },
    { "id": "player-collider", "name": "Player BoxCollider2D", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Player" }, "type_name": "BoxCollider2D" } },
    { "id": "player-freeze", "name": "Player freezeRotation", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Player" }, "type_name": "Rigidbody2D", "property_path": "freezeRotation", "value": true } },
    { "id": "player-gravity", "name": "Player gravityScale 2.5", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Player" }, "type_name": "Rigidbody2D", "property_path": "gravityScale", "value": 2.5 } },
    { "id": "player-assign", "name": "Assign blue sprite to Player", "kind": "tool_call", "tool": "unity_asset_assign_sprite", "arguments": { "locator": { "path": "/Player" }, "sprite_path": "Assets/Sprites/Blue.png" } },

    { "id": "create-platform-1", "name": "Create Platform1", "kind": "tool_call", "tool": "unity_scene_create_object", "arguments": { "name": "Platform1", "position": { "x": -4, "y": -1, "z": 0 }, "scale": { "x": 3, "y": 0.35, "z": 1 } } },
    { "id": "platform-1-renderer", "name": "Platform1 SpriteRenderer", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Platform1" }, "type_name": "SpriteRenderer" } },
    { "id": "platform-1-collider", "name": "Platform1 BoxCollider2D", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Platform1" }, "type_name": "BoxCollider2D" } },
    { "id": "platform-1-assign", "name": "Assign green sprite to Platform1", "kind": "tool_call", "tool": "unity_asset_assign_sprite", "arguments": { "locator": { "path": "/Platform1" }, "sprite_path": "Assets/Sprites/Green.png" } },

    { "id": "create-platform-2", "name": "Create Platform2", "kind": "tool_call", "tool": "unity_scene_create_object", "arguments": { "name": "Platform2", "position": { "x": 0, "y": 0.8, "z": 0 }, "scale": { "x": 3, "y": 0.35, "z": 1 } } },
    { "id": "platform-2-renderer", "name": "Platform2 SpriteRenderer", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Platform2" }, "type_name": "SpriteRenderer" } },
    { "id": "platform-2-collider", "name": "Platform2 BoxCollider2D", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Platform2" }, "type_name": "BoxCollider2D" } },
    { "id": "platform-2-assign", "name": "Assign green sprite to Platform2", "kind": "tool_call", "tool": "unity_asset_assign_sprite", "arguments": { "locator": { "path": "/Platform2" }, "sprite_path": "Assets/Sprites/Green.png" } },

    { "id": "create-platform-3", "name": "Create Platform3", "kind": "tool_call", "tool": "unity_scene_create_object", "arguments": { "name": "Platform3", "position": { "x": 4, "y": 2.5, "z": 0 }, "scale": { "x": 3, "y": 0.35, "z": 1 } } },
    { "id": "platform-3-renderer", "name": "Platform3 SpriteRenderer", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Platform3" }, "type_name": "SpriteRenderer" } },
    { "id": "platform-3-collider", "name": "Platform3 BoxCollider2D", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Platform3" }, "type_name": "BoxCollider2D" } },
    { "id": "platform-3-assign", "name": "Assign green sprite to Platform3", "kind": "tool_call", "tool": "unity_asset_assign_sprite", "arguments": { "locator": { "path": "/Platform3" }, "sprite_path": "Assets/Sprites/Green.png" } },

    { "id": "create-collectible-1", "name": "Create Coin1", "kind": "tool_call", "tool": "unity_scene_create_object", "arguments": { "name": "Coin1", "position": { "x": -4, "y": -0.3, "z": 0 }, "scale": { "x": 0.4, "y": 0.4, "z": 1 } } },
    { "id": "collectible-1-renderer", "name": "Coin1 SpriteRenderer", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Coin1" }, "type_name": "SpriteRenderer" } },
    { "id": "collectible-1-collider", "name": "Coin1 CircleCollider2D", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Coin1" }, "type_name": "CircleCollider2D" } },
    { "id": "collectible-1-trigger", "name": "Coin1 isTrigger", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Coin1" }, "type_name": "CircleCollider2D", "property_path": "isTrigger", "value": true } },
    { "id": "collectible-1-assign", "name": "Assign yellow sprite to Coin1", "kind": "tool_call", "tool": "unity_asset_assign_sprite", "arguments": { "locator": { "path": "/Coin1" }, "sprite_path": "Assets/Sprites/Yellow.png" } },

    { "id": "create-collectible-2", "name": "Create Coin2", "kind": "tool_call", "tool": "unity_scene_create_object", "arguments": { "name": "Coin2", "position": { "x": 0, "y": 1.5, "z": 0 }, "scale": { "x": 0.4, "y": 0.4, "z": 1 } } },
    { "id": "collectible-2-renderer", "name": "Coin2 SpriteRenderer", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Coin2" }, "type_name": "SpriteRenderer" } },
    { "id": "collectible-2-collider", "name": "Coin2 CircleCollider2D", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Coin2" }, "type_name": "CircleCollider2D" } },
    { "id": "collectible-2-trigger", "name": "Coin2 isTrigger", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Coin2" }, "type_name": "CircleCollider2D", "property_path": "isTrigger", "value": true } },
    { "id": "collectible-2-assign", "name": "Assign yellow sprite to Coin2", "kind": "tool_call", "tool": "unity_asset_assign_sprite", "arguments": { "locator": { "path": "/Coin2" }, "sprite_path": "Assets/Sprites/Yellow.png" } },

    { "id": "create-collectible-3", "name": "Create Coin3", "kind": "tool_call", "tool": "unity_scene_create_object", "arguments": { "name": "Coin3", "position": { "x": 4, "y": 3.2, "z": 0 }, "scale": { "x": 0.4, "y": 0.4, "z": 1 } } },
    { "id": "collectible-3-renderer", "name": "Coin3 SpriteRenderer", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Coin3" }, "type_name": "SpriteRenderer" } },
    { "id": "collectible-3-collider", "name": "Coin3 CircleCollider2D", "kind": "tool_call", "tool": "unity_component_add", "arguments": { "locator": { "path": "/Coin3" }, "type_name": "CircleCollider2D" } },
    { "id": "collectible-3-trigger", "name": "Coin3 isTrigger", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Coin3" }, "type_name": "CircleCollider2D", "property_path": "isTrigger", "value": true } },
    { "id": "collectible-3-assign", "name": "Assign yellow sprite to Coin3", "kind": "tool_call", "tool": "unity_asset_assign_sprite", "arguments": { "locator": { "path": "/Coin3" }, "sprite_path": "Assets/Sprites/Yellow.png" } },

    { "id": "create-script-player", "name": "Create PlayerController.cs (skip if exists)", "kind": "tool_call", "tool": "unity_code_create_script", "arguments": { "path": "Assets/Scripts/PlayerController.cs", "if_exists": "skip", "content": "using UnityEngine;\n\npublic class PlayerController : MonoBehaviour\n{\n    [SerializeField] private float moveSpeed = 6f;\n    [SerializeField] private float jumpSpeed = 12f;\n    [SerializeField] private float groundCheckDistance = 0.15f;\n    [SerializeField] private LayerMask groundLayers = ~0;\n    [SerializeField] private string enemyNamePrefix = \"Enemy\";\n    [SerializeField] private string coinNamePrefix = \"Coin\";\n    public GameManager gameManager;\n    private Rigidbody2D rb;\n    private Vector3 spawnPoint;\n    private bool facingRight = true;\n    private void Awake() { rb = GetComponent<Rigidbody2D>(); }\n    private void Start() { spawnPoint = transform.position; if (gameManager == null) gameManager = GameManager.Instance; }\n    private void Update() {\n        float moveInput = Input.GetAxisRaw(\"Horizontal\");\n        Vector2 velocity = ReadVelocity();\n        velocity.x = moveInput * moveSpeed;\n        if (Input.GetButtonDown(\"Jump\") && IsGrounded()) velocity.y = jumpSpeed;\n        WriteVelocity(velocity);\n        if (moveInput > 0 && !facingRight) Flip();\n        else if (moveInput < 0 && facingRight) Flip();\n    }\n    private bool IsGrounded() {\n        Vector2 origin = (Vector2)transform.position + Vector2.down * 0.4f;\n        RaycastHit2D hit = Physics2D.Raycast(origin, Vector2.down, groundCheckDistance, groundLayers);\n        return hit.collider != null && hit.collider.gameObject != gameObject;\n    }\n    private void Flip() {\n        facingRight = !facingRight;\n        Vector3 scale = transform.localScale;\n        scale.x = Mathf.Abs(scale.x) * (facingRight ? 1f : -1f);\n        transform.localScale = scale;\n    }\n    private void OnCollisionEnter2D(Collision2D c) {\n        if (c.gameObject.name.StartsWith(enemyNamePrefix)) {\n            if (gameManager != null) gameManager.PlayerDied();\n            Respawn();\n        }\n    }\n    private void OnTriggerEnter2D(Collider2D other) {\n        if (other.gameObject.name.StartsWith(coinNamePrefix)) {\n            if (gameManager != null) gameManager.AddScore(1);\n            Destroy(other.gameObject);\n        }\n    }\n    public void Respawn() { transform.position = spawnPoint; WriteVelocity(Vector2.zero); }\n    private Vector2 ReadVelocity() {\n#if UNITY_6000_0_OR_NEWER\n        return rb.linearVelocity;\n#else\n        return rb.velocity;\n#endif\n    }\n    private void WriteVelocity(Vector2 value) {\n#if UNITY_6000_0_OR_NEWER\n        rb.linearVelocity = value;\n#else\n        rb.velocity = value;\n#endif\n    }\n}\n" } },
    { "id": "create-script-gamemanager", "name": "Create GameManager.cs (skip if exists)", "kind": "tool_call", "tool": "unity_code_create_script", "arguments": { "path": "Assets/Scripts/GameManager.cs", "if_exists": "skip", "content": "using UnityEngine;\nusing UnityEngine.UI;\n\npublic class GameManager : MonoBehaviour\n{\n    public static GameManager Instance { get; private set; }\n    public Text scoreText;\n    public Text livesText;\n    public Text messageText;\n    [SerializeField] private int startLives = 3;\n    [SerializeField] private int totalCoins = 3;\n    public int score;\n    public int lives;\n    public bool isWin;\n    public bool isGameOver;\n    private void Awake() {\n        if (Instance != null && Instance != this) { Destroy(gameObject); return; }\n        Instance = this; lives = startLives;\n    }\n    private void Start() { if (messageText != null) messageText.text = \"\"; UpdateUI(); }\n    public void AddScore(int amount) {\n        if (isWin || isGameOver) return;\n        score += amount;\n        if (score >= totalCoins) { isWin = true; ShowMessage(\"YOU WIN!\"); }\n        UpdateUI();\n    }\n    public void PlayerDied() {\n        if (isWin || isGameOver) return;\n        lives--;\n        if (lives <= 0) { lives = 0; isGameOver = true; ShowMessage(\"GAME OVER\"); }\n        UpdateUI();\n    }\n    private void UpdateUI() {\n        if (scoreText != null) scoreText.text = $\"Score: {score}/{totalCoins}\";\n        if (livesText != null) livesText.text = $\"Lives: {lives}\";\n    }\n    private void ShowMessage(string msg) { if (messageText != null) messageText.text = msg; }\n}\n" } },
    { "id": "create-script-camera", "name": "Create PlatformerCameraController.cs (replace if exists)", "kind": "tool_call", "tool": "unity_code_create_script", "arguments": { "path": "Assets/Scripts/PlatformerCameraController.cs", "if_exists": "replace", "content": "using UnityEngine;\n\npublic class PlatformerCameraController : MonoBehaviour\n{\n    public Transform target;\n    [SerializeField] private float orthographicSize = 2.1f;\n    [SerializeField] private Vector2 deadZone = new Vector2(0.25f, 0.7f);\n    [SerializeField] private Vector2 lookAhead = new Vector2(1f, 0.15f);\n    [SerializeField] private Vector2 framingOffset = new Vector2(0f, -0.25f);\n    [SerializeField] private Vector2 damping = new Vector2(0.12f, 0.18f);\n    [SerializeField] private bool useBounds = true;\n    [SerializeField] private Vector2 minBounds = new Vector2(-9.5f, -3.6f);\n    [SerializeField] private Vector2 maxBounds = new Vector2(9.5f, 4.4f);\n    private Camera cam;\n    private Rigidbody2D targetBody;\n    private Vector2 smoothVelocity;\n    private Vector3 previousTargetPosition;\n    private void Awake() {\n        cam = GetComponent<Camera>();\n        if (cam != null) {\n            cam.orthographic = true;\n            cam.orthographicSize = orthographicSize;\n        }\n    }\n    private void Start() {\n        if (target == null) {\n            GameObject player = GameObject.Find(\"Player\");\n            if (player != null) target = player.transform;\n        }\n        if (target != null) {\n            targetBody = target.GetComponent<Rigidbody2D>();\n            previousTargetPosition = target.position;\n            SnapToTarget();\n        }\n    }\n    private void LateUpdate() {\n        if (target == null) return;\n        if (cam != null && Mathf.Abs(cam.orthographicSize - orthographicSize) > 0.001f) cam.orthographicSize = orthographicSize;\n        Vector3 current = transform.position;\n        Vector3 desired = current;\n        Vector3 rawTargetPosition = target.position;\n        Vector3 targetPosition = rawTargetPosition + (Vector3)framingOffset;\n        Vector2 delta = targetPosition - current;\n        if (Mathf.Abs(delta.x) > deadZone.x) desired.x = targetPosition.x - Mathf.Sign(delta.x) * deadZone.x;\n        if (Mathf.Abs(delta.y) > deadZone.y) desired.y = targetPosition.y - Mathf.Sign(delta.y) * deadZone.y;\n        Vector2 velocity = ReadTargetVelocity(rawTargetPosition);\n        desired.x += Mathf.Sign(velocity.x) * lookAhead.x;\n        desired.y += Mathf.Sign(velocity.y) * lookAhead.y;\n        desired.z = -10f;\n        desired = ClampToBounds(desired);\n        current.x = Mathf.SmoothDamp(current.x, desired.x, ref smoothVelocity.x, Mathf.Max(0.001f, damping.x));\n        current.y = Mathf.SmoothDamp(current.y, desired.y, ref smoothVelocity.y, Mathf.Max(0.001f, damping.y));\n        current.z = desired.z;\n        transform.position = current;\n        previousTargetPosition = rawTargetPosition;\n    }\n    private void SnapToTarget() {\n        Vector3 next = target.position + (Vector3)framingOffset;\n        next.z = -10f;\n        transform.position = ClampToBounds(next);\n    }\n    private Vector2 ReadTargetVelocity(Vector3 targetPosition) {\n        if (targetBody != null) {\n#if UNITY_6000_0_OR_NEWER\n            return targetBody.linearVelocity;\n#else\n            return targetBody.velocity;\n#endif\n        }\n        if (Time.deltaTime <= 0f) return Vector2.zero;\n        return (targetPosition - previousTargetPosition) / Time.deltaTime;\n    }\n    private Vector3 ClampToBounds(Vector3 value) {\n        if (!useBounds || cam == null) return value;\n        float halfHeight = cam.orthographicSize;\n        float halfWidth = halfHeight * cam.aspect;\n        value.x = ClampCenter(value.x, minBounds.x, maxBounds.x, halfWidth);\n        value.y = ClampCenter(value.y, minBounds.y, maxBounds.y, halfHeight);\n        return value;\n    }\n    private static float ClampCenter(float value, float min, float max, float extent) {\n        float low = min + extent;\n        float high = max - extent;\n        if (low > high) return (min + max) * 0.5f;\n        return Mathf.Clamp(value, low, high);\n    }\n}\n" } },
    { "id": "refresh-assets", "name": "Refresh AssetDatabase to pick up new scripts", "kind": "tool_call", "tool": "unity_editor_refresh_assets", "arguments": {} },
    { "id": "wait-compile", "name": "Wait for compile to finish", "kind": "tool_call", "tool": "unity_editor_wait_for", "arguments": { "compiling": false, "updating": false, "timeoutMs": 30000 } },

    { "id": "create-gamemanager-go", "name": "Create GameManager GameObject", "kind": "tool_call", "tool": "unity_scene_create_object", "arguments": { "name": "GameManager" } },
    { "id": "attach-gamemanager", "name": "Attach GameManager script", "kind": "tool_call", "tool": "unity_code_attach_script", "arguments": { "locator": { "path": "/GameManager" }, "script_name": "GameManager" } },
    { "id": "attach-player-controller", "name": "Attach PlayerController script", "kind": "tool_call", "tool": "unity_code_attach_script", "arguments": { "locator": { "path": "/Player" }, "script_name": "PlayerController" } },
    { "id": "attach-camera-controller", "name": "Attach PlatformerCameraController script", "kind": "tool_call", "tool": "unity_code_attach_script", "arguments": { "locator": { "path": "/Main Camera" }, "script_name": "PlatformerCameraController" } },
    { "id": "camera-target", "name": "Wire PlatformerCameraController.target", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Main Camera" }, "type_name": "PlatformerCameraController", "property_path": "target", "value": { "locator": { "path": "/Player" } } } },
    { "id": "camera-size-profile", "name": "Camera profile orthographic size", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Main Camera" }, "type_name": "PlatformerCameraController", "property_path": "orthographicSize", "value": 2.1 } },
    { "id": "camera-dead-zone", "name": "Camera profile dead zone", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Main Camera" }, "type_name": "PlatformerCameraController", "property_path": "deadZone", "value": { "x": 0.25, "y": 0.7 } } },
    { "id": "camera-look-ahead", "name": "Camera profile look ahead", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Main Camera" }, "type_name": "PlatformerCameraController", "property_path": "lookAhead", "value": { "x": 1, "y": 0.15 } } },
    { "id": "camera-framing-offset", "name": "Camera profile framing offset", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Main Camera" }, "type_name": "PlatformerCameraController", "property_path": "framingOffset", "value": { "x": 0, "y": -0.25 } } },
    { "id": "camera-damping", "name": "Camera profile damping", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Main Camera" }, "type_name": "PlatformerCameraController", "property_path": "damping", "value": { "x": 0.12, "y": 0.18 } } },
    { "id": "camera-use-bounds", "name": "Camera profile bounds on", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Main Camera" }, "type_name": "PlatformerCameraController", "property_path": "useBounds", "value": true } },
    { "id": "camera-min-bounds", "name": "Camera profile min bounds", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Main Camera" }, "type_name": "PlatformerCameraController", "property_path": "minBounds", "value": { "x": -9.5, "y": -3.6 } } },
    { "id": "camera-max-bounds", "name": "Camera profile max bounds", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Main Camera" }, "type_name": "PlatformerCameraController", "property_path": "maxBounds", "value": { "x": 9.5, "y": 4.4 } } },

    { "id": "create-canvas", "name": "Create UI Canvas", "kind": "tool_call", "tool": "unity_ui_create_canvas", "arguments": { "name": "Canvas", "render_mode": "overlay" } },
    { "id": "create-score-text", "name": "Create ScoreText", "kind": "tool_call", "tool": "unity_ui_add_text", "arguments": { "parent": { "path": "/Canvas" }, "name": "ScoreText", "text": "Score: 0/3", "text_backend": "legacy", "font_size": 28, "color": { "r": 1, "g": 1, "b": 1, "a": 1 } } },
    { "id": "score-rect", "name": "Anchor ScoreText top-left", "kind": "tool_call", "tool": "unity_ui_set_rect_transform", "arguments": { "locator": { "path": "/Canvas/ScoreText" }, "anchor_min": { "x": 0, "y": 1 }, "anchor_max": { "x": 0, "y": 1 }, "pivot": { "x": 0, "y": 1 }, "anchored_position": { "x": 20, "y": -20 }, "size_delta": { "x": 320, "y": 40 } } },
    { "id": "create-lives-text", "name": "Create LivesText", "kind": "tool_call", "tool": "unity_ui_add_text", "arguments": { "parent": { "path": "/Canvas" }, "name": "LivesText", "text": "Lives: 3", "text_backend": "legacy", "font_size": 24, "color": { "r": 1, "g": 1, "b": 1, "a": 1 } } },
    { "id": "lives-rect", "name": "Anchor LivesText top-left below score", "kind": "tool_call", "tool": "unity_ui_set_rect_transform", "arguments": { "locator": { "path": "/Canvas/LivesText" }, "anchor_min": { "x": 0, "y": 1 }, "anchor_max": { "x": 0, "y": 1 }, "pivot": { "x": 0, "y": 1 }, "anchored_position": { "x": 20, "y": -70 }, "size_delta": { "x": 320, "y": 40 } } },
    { "id": "create-message-text", "name": "Create MessageText", "kind": "tool_call", "tool": "unity_ui_add_text", "arguments": { "parent": { "path": "/Canvas" }, "name": "MessageText", "text": "", "text_backend": "legacy", "font_size": 48, "color": { "r": 1, "g": 0.9, "b": 0.2, "a": 1 }, "alignment": "MiddleCenter" } },
    { "id": "message-rect", "name": "Anchor MessageText center", "kind": "tool_call", "tool": "unity_ui_set_rect_transform", "arguments": { "locator": { "path": "/Canvas/MessageText" }, "anchor_min": { "x": 0.5, "y": 0.5 }, "anchor_max": { "x": 0.5, "y": 0.5 }, "pivot": { "x": 0.5, "y": 0.5 }, "anchored_position": { "x": 0, "y": 0 }, "size_delta": { "x": 600, "y": 80 } } },

    { "id": "wire-score-text", "name": "Wire GameManager.scoreText", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/GameManager" }, "type_name": "GameManager", "property_path": "scoreText", "value": { "locator": { "path": "/Canvas/ScoreText" } } } },
    { "id": "wire-lives-text", "name": "Wire GameManager.livesText", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/GameManager" }, "type_name": "GameManager", "property_path": "livesText", "value": { "locator": { "path": "/Canvas/LivesText" } } } },
    { "id": "wire-message-text", "name": "Wire GameManager.messageText", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/GameManager" }, "type_name": "GameManager", "property_path": "messageText", "value": { "locator": { "path": "/Canvas/MessageText" } } } },
    { "id": "wire-player-gamemanager", "name": "Wire PlayerController.gameManager", "kind": "tool_call", "tool": "unity_component_set_property", "arguments": { "locator": { "path": "/Player" }, "type_name": "PlayerController", "property_path": "gameManager", "value": { "locator": { "path": "/GameManager" } } } },

    { "id": "edit-screenshot", "name": "Edit-mode screenshot for evidence", "kind": "capture_screenshot", "view": "game", "format": "jpeg", "quality": 75 },

    { "id": "enter-play", "name": "Enter play mode", "kind": "tool_call", "tool": "unity_editor_play", "arguments": {} },
    { "id": "wait-playing", "name": "Wait until play mode active", "kind": "tool_call", "tool": "unity_editor_wait_for", "arguments": { "playMode": "playing", "timeoutMs": 15000 } },
    { "id": "player-active-check", "name": "Player exists in play", "kind": "runtime_wait", "locator": { "path": "Player" }, "property_path": "activeInHierarchy", "operator": "equals", "expected": true, "timeoutMs": 3000 },

    { "id": "input-session-start", "name": "Begin input session", "kind": "tool_call", "tool": "unity_input_begin_session", "arguments": {} },
    { "id": "snapshot-pre", "name": "Snapshot Player before input", "kind": "tool_call", "tool": "unity_runtime_get_snapshot", "arguments": { "locator": { "path": "Player" } } },
    { "id": "input-jump", "name": "Tap Space (jump)", "kind": "tool_call", "tool": "unity_input_key_tap", "arguments": { "key": "Space" } },
    { "id": "input-right-down", "name": "Hold RightArrow", "kind": "tool_call", "tool": "unity_input_key_down", "arguments": { "key": "RightArrow" } },
    { "id": "wait-motion", "name": "Wait 250ms for motion", "kind": "tool_call", "tool": "unity_editor_wait_for", "arguments": { "delayMs": 250 } },
    { "id": "input-right-up", "name": "Release RightArrow", "kind": "tool_call", "tool": "unity_input_key_up", "arguments": { "key": "RightArrow" } },
    { "id": "input-session-end", "name": "End input session", "kind": "tool_call", "tool": "unity_input_end_session", "arguments": {} },
    { "id": "snapshot-post", "name": "Snapshot Player after input", "kind": "tool_call", "tool": "unity_runtime_get_snapshot", "arguments": { "locator": { "path": "Player" } } },
    { "id": "assert-moved-right", "name": "Assert Player moved right (x > 0.1)", "kind": "runtime_assert", "locator": { "path": "Player" }, "property_path": "transform.position.x", "operator": "greater_than", "expected": 0.1 },
    { "id": "assert-camera-followed-right", "name": "Assert Camera followed player right", "kind": "runtime_assert", "locator": { "path": "Main Camera" }, "property_path": "transform.position.x", "operator": "greater_than", "expected": 0.05 },

    { "id": "game-screenshot", "name": "Game view screenshot in play mode", "kind": "capture_screenshot", "view": "game", "format": "jpeg", "quality": 75 },
    { "id": "exit-play", "name": "Exit play mode", "kind": "tool_call", "tool": "unity_editor_stop", "arguments": {} },

    { "id": "save-scene", "name": "Save scene as FreshPlatformer.unity", "kind": "tool_call", "tool": "unity_scene_save_scene", "arguments": { "path": "Assets/FreshPlatformer.unity" } }
  ]
}
