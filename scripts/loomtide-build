#!/usr/bin/env bash
# Codex wrapper for `loomtide build` (plan §3d). GENERATED by scripts/sync-loomtide-artifacts.mjs — do not edit by hand.
#
# Points Codex at the SAME canonical command body Claude Code uses
# (commands/loomtide/build.md) — one source of truth, so the two agents cannot drift.
# `--ephemeral` gives a fresh `codex` process = genuine fresh context (§3b).
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

# Join ALL positional args so unquoted multi-word intents survive (e.g.
# `loomtide-build add coin pickup` → INTENT="add coin pickup").
INTENT="${*:-}"
PROMPT="Open and follow commands/loomtide/build.md. Make the project match the contract for this intent: ${INTENT:-(no intent given — ask the user before mutating)}"

CODEX_ARGS=(
  --ask-for-approval "on-request"
  --sandbox "workspace-write"
  --config 'model_reasoning_effort="high"'
)
if [[ "${LOOMTIDE_SEARCH:-1}" == "1" ]]; then
  CODEX_ARGS+=(--search)
fi
CODEX_ARGS+=(exec --ephemeral)
if [[ "${LOOMTIDE_JSON:-0}" == "1" ]]; then
  CODEX_ARGS+=(--json)
fi

codex "${CODEX_ARGS[@]}" "$PROMPT"
