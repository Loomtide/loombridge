#!/usr/bin/env bash
# Codex wrapper for `loomtide end-to-end demo workflow` (plan §3d). GENERATED by scripts/sync-loomtide-artifacts.mjs — do not edit by hand.
#
# Points Codex at the SAME canonical command body Claude Code uses
# (commands/loomtide/e2e.md) — one source of truth, so the two agents cannot drift.
# `--ephemeral` gives a fresh `codex` process = genuine fresh context (§3b).
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

BUNDLE="${1:-}"
if [[ -z "$BUNDLE" ]]; then
  PROMPT="Open and follow commands/loomtide/e2e.md. Ask for the demo bundle path, then run the prepared end-to-end demo workflow through the real Loomtide CLI commands."
else
  PROMPT="Open and follow commands/loomtide/e2e.md. Use demo bundle: ${BUNDLE}. Run the prepared end-to-end demo workflow through the real Loomtide CLI commands."
fi

CODEX_ARGS=(
  --ask-for-approval "on-request"
  --sandbox "workspace-write"
  --config 'model_reasoning_effort="high"'
)
if [[ "${LOOMTIDE_SEARCH:-1}" == "1" ]]; then
  CODEX_ARGS+=(--search)
fi
CODEX_ARGS+=(exec --ephemeral)
if [[ "${LOOMTIDE_JSON:-0}" == "1" ]]; then
  CODEX_ARGS+=(--json)
fi

codex "${CODEX_ARGS[@]}" "$PROMPT"
