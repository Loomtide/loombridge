#!/usr/bin/env bash
# Codex wrapper for `loombridge verify` (plan §3d). GENERATED by scripts/sync-loombridge-artifacts.mjs — do not edit by hand.
#
# Points Codex at the SAME canonical command body Claude Code uses
# (commands/loombridge/verify.md) — one source of truth, so the two agents cannot drift.
# `--ephemeral` gives a fresh `codex` process = genuine fresh context (§3b).
set -euo pipefail

SCRIPT_DIR="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd -- "$SCRIPT_DIR/.." && pwd)"
cd "$REPO_ROOT"

PROMPT="Open and follow commands/loombridge/verify.md. Run the Tier-1 gates and report the enforced verdict."

CODEX_ARGS=(
  --ask-for-approval "on-request"
  --sandbox "workspace-write"
  --config 'model_reasoning_effort="low"'
)
CODEX_ARGS+=(exec --ephemeral)
if [[ "${LOOMBRIDGE_JSON:-0}" == "1" ]]; then
  CODEX_ARGS+=(--json)
fi

codex "${CODEX_ARGS[@]}" "$PROMPT"
