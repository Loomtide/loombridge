{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://loomtide.dev/schemas/asset-manifest.schema.json",
  "title": "Loomtide Asset Manifest — .loomtide/ASSET_MANIFEST.json",
  "description": "Product-owned visual asset source contract. Records the approved asset strategy and the durable asset bindings slices must consume instead of independently searching the registry.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "mode", "status", "heroShot", "assetSources", "assets", "sliceBindings", "replacementPolicy"],
  "properties": {
    "version": { "const": 1 },
    "genre": {
      "type": "string",
      "minLength": 1,
      "description": "Optional asset genre id (e.g. \"3d-shooter\"); selects required roles, slice bindings, and registry role-rules. Absent ⇒ the platformer-2d default."
    },
    "mode": {
      "enum": ["registry", "generated", "hybrid"],
      "description": "Visible, approved asset strategy: registry-first, generate-first, or hybrid."
    },
    "status": { "enum": ["draft", "approved"] },
    "approvedAt": { "type": ["string", "null"], "format": "date-time" },
    "heroShot": { "$ref": "#/$defs/heroShot" },
    "assetSources": {
      "type": "array",
      "items": { "$ref": "#/$defs/assetSource" }
    },
    "assets": {
      "type": "array",
      "items": { "$ref": "#/$defs/asset" }
    },
    "sliceBindings": {
      "type": "array",
      "items": { "$ref": "#/$defs/sliceBinding" }
    },
    "replacementPolicy": { "$ref": "#/$defs/replacementPolicy" }
  },
  "$defs": {
    "safeId": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]*$"
    },
    "safePath": {
      "type": "string",
      "minLength": 1,
      "description": "Safe relative path; runtime validation additionally rejects absolute paths, backslashes, empty segments, '.', and '..'."
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "heroShot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": { "$ref": "#/$defs/safePath" },
        "sha256": { "$ref": "#/$defs/sha256" }
      }
    },
    "assetSource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "approved"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "kind": { "enum": ["registry-pack", "generated-set", "manual-import"] },
        "registry": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 },
        "approved": { "type": "boolean" }
      }
    },
    "heroRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": { "type": "number", "minimum": 0 },
        "y": { "type": "number", "minimum": 0 },
        "w": { "type": "number", "exclusiveMinimum": 0 },
        "h": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "asset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "source", "status", "requiredOutputs"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" },
        "role": { "type": "string", "minLength": 1 },
        "source": { "enum": ["generated", "registry", "manual"] },
        "sourceId": { "$ref": "#/$defs/safeId" },
        "status": { "enum": ["approved", "needed", "placeholder"] },
        "heroRegion": { "$ref": "#/$defs/heroRegion" },
        "requiredOutputs": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "resolvedPaths": {
          "type": "array",
          "items": { "$ref": "#/$defs/safePath" }
        },
        "styleLock": { "type": "string", "minLength": 1 },
        "registrySelection": { "$ref": "#/$defs/registrySelection" },
        "generatedExport": { "$ref": "#/$defs/generatedExport" },
        "primitiveFinal": {
          "type": "boolean",
          "description": "Gray-box / feel-only (RCL-D02): the engine primitive is the intended FINAL deliverable for this role. Such a role passes the asset gate by design (no resolved paths / registry-or-generated provenance required, and asset-source fidelity marks it PASS). A role NOT marked still requires a real, path-bound asset."
        }
      }
    },
    "generatedExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generatedSetId", "generator", "sourceImageSha256", "producedAt", "license", "provenance"],
      "properties": {
        "generatedSetId": { "type": "string", "minLength": 1 },
        "generator": { "type": "string", "minLength": 1 },
        "sourceImageSha256": { "$ref": "#/$defs/sha256" },
        "producedAt": { "type": "string", "format": "date-time" },
        "license": { "type": "string", "minLength": 1 },
        "provenance": {
          "type": "object",
          "additionalProperties": {
            "type": ["string", "number", "boolean", "null"]
          },
          "required": ["origin"],
          "properties": {
            "origin": { "enum": ["hero-shot-annotation", "manual-export", "procedural"] },
            "annotationId": { "type": "string", "minLength": 1 },
            "prompt": { "type": "string", "minLength": 1 },
            "seed": { "type": ["string", "number"] },
            "tool": { "type": "string", "minLength": 1 },
            "notes": { "type": "string", "minLength": 1 }
          }
        }
      }
    },
    "registrySelection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registryAssetId", "packId", "primitive", "license", "source", "provider", "placeholder"],
      "properties": {
        "registryAssetId": { "type": "string", "minLength": 1 },
        "packId": { "type": "string", "minLength": 1 },
        "primitive": { "type": "string", "minLength": 1 },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "spdx", "url", "requiresAttribution"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "spdx": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "requiresAttribution": { "type": "boolean" }
          }
        },
        "source": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "url", "author", "provenance"],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 },
            "author": { "type": "string", "minLength": 1 },
            "provenance": {
              "type": "object",
              "additionalProperties": {
                "type": ["string", "number", "boolean", "null"]
              }
            }
          }
        },
        "provider": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "url"],
          "properties": {
            "name": { "type": "string", "minLength": 1 },
            "url": { "type": "string", "minLength": 1 }
          }
        },
        "placeholder": { "type": "boolean" }
      }
    },
    "sliceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sliceId", "assetIds"],
      "properties": {
        "sliceId": { "$ref": "#/$defs/safeId" },
        "assetIds": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/safeId" }
        }
      }
    },
    "replacementPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowUnapprovedRegistryFallback", "allowPlaceholders", "requiresUserApprovalForSourceChange"],
      "properties": {
        "allowUnapprovedRegistryFallback": { "type": "boolean", "const": false },
        "allowPlaceholders": { "type": "boolean" },
        "requiresUserApprovalForSourceChange": { "type": "boolean", "const": true }
      }
    }
  }
}
