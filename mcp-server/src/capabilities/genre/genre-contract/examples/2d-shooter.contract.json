{
  "schemaVersion": "0.1.0",
  "genreId": "2d-shooter",
  "subGenres": ["top-down", "twin-stick"],
  "confidence": "experimental",

  "targetPlatform": {
    "device": "pc",
    "inputScheme": "kb-mouse",
    "aspect": "16:9",
    "session": "short-arena"
  },
  "networkModel": {
    "mode": "single-player",
    "spPlayable": true
  },
  "coreLoop": {
    "description": "move, aim, shoot, kill, survive a wave, upgrade",
    "perspective": "top-down",
    "subGenre": "twin-stick",
    "genreClass": "twitch"
  },
  "artDirection": {
    "style": "stylized neon arcade",
    "assetRoles": [
      "player-character",
      "weapon",
      "reticle",
      "player-projectile",
      "enemy",
      "arena-floor",
      "arena-wall",
      "muzzle-vfx",
      "hit-vfx",
      "death-vfx",
      "health-hud",
      "ammo-hud",
      "wave-score-hud",
      "combat-sfx"
    ],
    "theme": "neon",
    "heroShotMock": "design/2d-shooter-hero.png"
  },
  "verticalSliceBudget": {
    "coreVerticalContent": { "weapon": 1, "enemy": 1, "arena": 1 },
    "deferred": ["weapon-roster", "enemy-variety", "progression", "matchmaking"]
  },

  "feedbackChains": [
    {
      "verb": "fire",
      "input": "LMB",
      "response": "projectile spawn",
      "feedback": "muzzle flash + fire SFX + crosshair bloom; on impact: hit-marker + spark + damage number; on kill: death VFX + SFX + score"
    },
    {
      "verb": "move",
      "input": "WASD",
      "response": "character acceleration",
      "feedback": "directional dust + footstep cadence"
    },
    {
      "verb": "take-damage",
      "input": "enemy contact / projectile",
      "response": "health decrement + brief i-frame",
      "feedback": "screen-edge blood vignette + shake"
    }
  ],
  "tunables": [
    { "id": "fireIntervalMs", "description": "time between shots", "unit": "ms" },
    { "id": "fireInputToSpawnLatency", "description": "latency from fire input onset to projectile spawn", "unit": "ms" },
    { "id": "projectileSpeed", "description": "bullet travel speed", "unit": "u/s" },
    { "id": "moveSpeed", "description": "player run speed", "unit": "u/s" },
    { "id": "ttkMs", "description": "time to kill the reference enemy", "unit": "ms" },
    { "id": "screenShakeMag", "description": "peak camera shake displacement on impact (measured from the camera transform)", "unit": "u" },
    { "id": "hitstopMs", "description": "hit-stop window duration on impact", "unit": "ms" }
  ],

  "measurabilityMap": [
    {
      "target": "inputToSfxLatency",
      "tag": "measurable-now",
      "calculator": "inputToSfxLatency",
      "band": { "max": 50, "unit": "ms" },
      "evidenceKind": "pack-default",
      "bucket": "coreVertical"
    },
    {
      "target": "fireIntervalMs",
      "tag": "measurable-now",
      "calculator": "fireIntervalMs",
      "band": { "min": 90, "max": 140, "unit": "ms" },
      "evidenceKind": "pack-default",
      "bucket": "coreVertical"
    },
    {
      "target": "projectileSpeed",
      "tag": "measurable-now",
      "calculator": "projectileSpeed",
      "band": { "min": 18, "max": 30, "unit": "u/s" },
      "evidenceKind": "pack-default",
      "bucket": "coreVertical"
    },
    {
      "target": "fireInputToSpawnLatency",
      "tag": "measurable-now",
      "calculator": "fireInputToSpawnLatency",
      "band": { "max": 50, "unit": "ms" },
      "evidenceKind": "pack-default",
      "bucket": "coreVertical"
    },
    {
      "target": "ttkMs",
      "tag": "measurable-now",
      "calculator": "ttkMs",
      "band": { "min": 150, "max": 600, "unit": "ms" },
      "evidenceKind": "pack-default",
      "bucket": "coreVertical"
    },
    {
      "target": "hitstopMs",
      "tag": "measurable-now",
      "calculator": "hitstopMs",
      "band": { "min": 60, "max": 180, "unit": "ms" },
      "evidenceKind": "pack-default",
      "bucket": "coreVertical"
    },
    {
      "target": "screenShakeMag",
      "tag": "measurable-now",
      "calculator": "screenShakeMag",
      "band": { "min": 0.1, "max": 0.6, "unit": "u" },
      "evidenceKind": "pack-default",
      "bucket": "coreVertical"
    },
    {
      "target": "aiming-feel",
      "tag": "judgment-only",
      "bucket": "coreVertical"
    }
  ],
  "referenceAnchor": {
    "exemplars": ["Enter the Gungeon (twin-stick reference)"],
    "notes": "Bands are pack-default/exemplar-set; inputToSfxLatency, fireIntervalMs, fireInputToSpawnLatency, projectileSpeed, ttkMs, hitstopMs, and screenShakeMag are verifiable today when the build exposes the matching sampled signals: weapon fire/spawn counters, the projectile as the measured trajectory subject, the reference enemy's hit/death signals (ttkMs is measured first-hit->death), a deterministic hit-stop window signal (hitstopMs), or the camera transform shaking on impact (screenShakeMag = peak camera displacement)."
  },

  "sliceDag": {
    "coreVertical": [
      { "id": "arena", "title": "Arena + framing", "dependsOn": [], "confidence": "experimental", "gates": ["manifest", "framing", "console-clean"] },
      { "id": "controller", "title": "Player controller + move", "dependsOn": ["arena"], "confidence": "experimental", "gates": ["manifest", "console-clean"], "gaps": ["move-feel-measurement"] },
      { "id": "weapon", "title": "Weapon core: fire -> projectile + impact", "dependsOn": ["controller"], "confidence": "experimental", "gates": ["manifest", "console-clean"], "gaps": ["spawn-aware-capture"] },
      { "id": "enemy", "title": "Enemy + health/damage + death", "dependsOn": ["weapon"], "confidence": "experimental", "gates": ["manifest", "console-clean"], "gaps": ["ttk-live-capture"] },
      { "id": "feedback", "title": "Combat feedback (muzzle/hitmarker/shake/hitstop)", "dependsOn": ["enemy"], "confidence": "experimental", "gates": ["manifest", "console-clean", "visual-artifacts"], "gaps": ["hitstop-measurement", "screenshake-measurement"] },
      { "id": "hud", "title": "HUD (health/ammo/score)", "dependsOn": ["enemy"], "confidence": "experimental", "gates": ["manifest", "ui-conformance", "console-clean"] },
      { "id": "end-state", "title": "Death / victory end-state", "dependsOn": ["enemy"], "confidence": "experimental", "gates": ["manifest", "console-clean"] }
    ],
    "deferredMeta": [
      { "id": "weapon-roster", "title": "Multiple weapons", "dependsOn": [], "confidence": "experimental", "kind": "roster", "gaps": ["deferred-meta"] },
      { "id": "progression", "title": "Upgrades / unlocks", "dependsOn": [], "confidence": "experimental", "kind": "progression", "gaps": ["deferred-meta"] }
    ]
  },
  "refusalConditions": [
    { "condition": "remaining shooter feel beyond current calculators", "reason": "automatic spawned-object discovery and secondary combat feel (crosshair bloom, screen-edge vignette, directional dust) have no calculator yet and are kept as methodology gaps, not faked. fireIntervalMs, fireInputToSpawnLatency, projectileSpeed, ttkMs, hitstopMs, and screenShakeMag have implemented calculators and are measured live when the build exposes the matching signals" },
    { "condition": "aim-assist fairness", "reason": "judgment-only; requires a human oracle" }
  ],
  "humanOracleChecks": [
    { "check": "does aiming feel responsive and fair?", "appliesTo": "aiming-feel" }
  ]
}
