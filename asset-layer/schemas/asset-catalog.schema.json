{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://loomtide.local/schemas/asset-catalog.schema.json",
  "title": "Loomtide Hosted Asset Catalog",
  "oneOf": [
    { "$ref": "#/$defs/catalogRecord" },
    { "$ref": "#/$defs/catalogShard" }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "uri": {
      "type": "string",
      "format": "uri"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "review": {
      "type": "object",
      "required": ["status"],
      "additionalProperties": false,
      "properties": {
        "status": {
          "type": "string",
          "enum": ["unreviewed", "needs-review", "verified", "rejected"]
        },
        "verifiedBy": {
          "type": "string",
          "enum": ["developer", "loomtide", "source-owner"]
        },
        "verifiedAt": {
          "type": "string",
          "minLength": 1
        },
        "reviewer": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        }
      }
    },
    "source": {
      "type": "object",
      "required": ["title", "url", "author", "provenance"],
      "additionalProperties": true,
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/uri" },
        "downloadPage": { "$ref": "#/$defs/uri" },
        "author": { "type": "string", "minLength": 1 },
        "verified": { "type": "boolean" },
        "provenance": {
          "type": "object",
          "required": ["verifiedAt", "origin"],
          "additionalProperties": true,
          "properties": {
            "verifiedAt": { "type": "string", "minLength": 1 },
            "origin": { "type": "string", "minLength": 1 },
            "fixture": { "type": "string", "minLength": 1 },
            "url": { "$ref": "#/$defs/uri" },
            "notes": { "type": "string" }
          }
        }
      }
    },
    "license": {
      "type": "object",
      "required": ["name", "spdx", "url", "requiresAttribution"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "spdx": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/uri" },
        "requiresAttribution": { "type": "boolean" }
      }
    },
    "provider": {
      "type": "object",
      "required": ["name", "url"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/uri" },
        "type": { "type": "string", "enum": ["local", "http", "generation"] },
        "acquisitionLane": { "type": "string", "enum": ["api", "mirror-index", "scraped-discovery"] },
        "termsNotes": { "type": "string" }
      }
    },
    "file": {
      "type": "object",
      "required": ["role", "format"],
      "additionalProperties": false,
      "properties": {
        "role": { "type": "string", "enum": ["sprite", "spritesheet", "background", "decor", "audio", "model"] },
        "format": { "type": "string", "enum": ["png", "jpg", "jpeg", "wav", "ogg", "glb"] },
        "localPath": { "type": "string", "minLength": 1 },
        "url": { "$ref": "#/$defs/uri" },
        "githubRawUrl": { "$ref": "#/$defs/uri" },
        "githubBlobUrl": { "$ref": "#/$defs/uri" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "checksum": {
          "type": "object",
          "required": ["algorithm", "value"],
          "additionalProperties": false,
          "properties": {
            "algorithm": { "type": "string", "const": "sha256" },
            "value": { "$ref": "#/$defs/sha256" }
          }
        }
      }
    },
    "technical": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 },
        "pixelsPerUnit": { "type": "integer", "minimum": 1 },
        "transparent": { "type": "boolean" },
        "sampleRate": { "type": "integer", "minimum": 1 },
        "channels": { "type": "integer", "minimum": 1 },
        "bitDepth": { "type": "integer", "minimum": 1 },
        "durationMs": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "unity": {
      "type": "object",
      "required": ["path", "pixelsPerUnit"],
      "additionalProperties": true,
      "properties": {
        "path": { "type": "string", "pattern": "^Assets/.+" },
        "pixelsPerUnit": { "type": "integer", "minimum": 1 },
        "spriteMode": { "type": "string", "enum": ["single", "multiple"] },
        "filterMode": { "type": "string", "enum": ["Point", "Bilinear"] },
        "defaultSpriteName": { "type": "string", "minLength": 1 }
      }
    },
    "packMembership": {
      "type": "object",
      "required": ["packId"],
      "additionalProperties": false,
      "properties": {
        "packId": { "$ref": "#/$defs/id" },
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "catalogPath": { "type": "string", "minLength": 1 }
      }
    },
    "catalogRecord": {
      "type": "object",
      "required": [
        "id",
        "genre",
        "primitive",
        "source",
        "license",
        "provider",
        "technical",
        "tags",
        "unity",
        "review"
      ],
      "additionalProperties": true,
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "genre": { "type": "string", "minLength": 1 },
        "primitive": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "enum": ["sprite", "audio", "material", "model"] },
        "priority": { "type": "integer", "minimum": 0 },
        "placeholder": { "type": "boolean" },
        "source": { "$ref": "#/$defs/source" },
        "license": { "$ref": "#/$defs/license" },
        "provider": { "$ref": "#/$defs/provider" },
        "files": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/file" }
        },
        "file": { "$ref": "#/$defs/file" },
        "localPath": { "type": "string", "minLength": 1 },
        "githubRawUrl": { "$ref": "#/$defs/uri" },
        "githubBlobUrl": { "$ref": "#/$defs/uri" },
        "sizeBytes": { "type": "integer", "minimum": 1 },
        "technical": { "$ref": "#/$defs/technical" },
        "tags": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "unity": { "$ref": "#/$defs/unity" },
        "review": { "$ref": "#/$defs/review" },
        "acquisitionLane": { "type": "string", "enum": ["api", "mirror-index", "scraped-discovery"] },
        "trustTier": { "type": "string", "enum": ["trusted-default", "attribution-required", "unverified-discovery", "blocked"] },
        "policyStatus": { "type": "string", "enum": ["trusted-default", "attribution-required", "unverified-discovery", "blocked"] },
        "category": { "type": "string", "minLength": 1 },
        "pack": { "$ref": "#/$defs/packMembership" }
      }
    },
    "catalogShard": {
      "type": "object",
      "required": ["schemaVersion", "assets"],
      "additionalProperties": false,
      "properties": {
        "schemaVersion": { "type": "string", "const": "1" },
        "catalogId": { "$ref": "#/$defs/id" },
        "provider": { "$ref": "#/$defs/provider" },
        "pack": { "$ref": "#/$defs/packMembership" },
        "assets": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/catalogRecord" }
        }
      }
    }
  }
}
